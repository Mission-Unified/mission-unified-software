# Copy this file to .env before running the dashboard.
# These are the defaults for a backend running on the same machine.

VITE_API_URL=http://localhost:8000
VITE_TELEMETRY_WS=ws://localhost:8000/ws/telemetry
VITE_VISION_WS=ws://localhost:8000/ws/vision

# true serves generated telemetry so the dashboard can be run with no vehicle attached
VITE_MOCK_DATA=false
